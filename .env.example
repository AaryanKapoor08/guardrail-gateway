# Copy to .env and fill in. Names only here — never commit real values.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# SnapTrade OAuth (we are a client) — Dashboard > OAuth Apps > Test app
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_REDIRECT_URI=http://localhost:3000/oauth/snaptrade/callback
SNAPTRADE_ISSUER=https://api.snaptrade.com
SNAPTRADE_API_BASE_URL=https://api.snaptrade.com
SNAPTRADE_REQUEST_TRADE_SCOPE=false
# Dashboard > API Keys — used ONLY to verify webhook signatures
SNAPTRADE_CONSUMER_KEY=

# Database / crypto
# Neon pooled URL; use sslmode=verify-full (pg treats require as verify-full today and will weaken it in pg v9)
DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/guardrail_test
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Our OAuth server for MCP clients
MCP_ALLOWED_CLIENT_HOSTS=claude.ai

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Live trading safety (server-wide)
LIVE_TRADING_ENABLED=false
LIVE_TRADING_PAPER_ACCOUNTS_ONLY=true
